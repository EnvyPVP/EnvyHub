-- =============================================
--  KICK ENVY
-- =============================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local placeId = game.PlaceId

-- ==================== CONFIG ====================
local TARGET_PLACE_SKIP = 99606176102979
local TARGET_PLACE_LOADING = 109983668079237

local scriptUrl = "https://raw.githubusercontent.com/EnvyPVP/EnvyHub/refs/heads/main/Kickenvy"
-- ===============================================

-- SALTAR DIRECTO
if placeId == TARGET_PLACE_SKIP then
    loadstring(game:HttpGet(scriptUrl))()
    return
end

if placeId == TARGET_PLACE_LOADING then

    local playerGui = player:WaitForChild("PlayerGui")

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "LoadingScreen"
    screenGui.ResetOnSpawn = false
    screenGui.DisplayOrder = 999999999
    screenGui.IgnoreGuiInset = true
    screenGui.Parent = playerGui

    -- FRAME PRINCIPAL
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 380, 0, 380) -- leve aumento
    frame.Position = UDim2.new(0.5, -190, 0.5, -190)
    frame.BackgroundTransparency = 1
    frame.ZIndex = 10
    frame.Parent = screenGui

    -- RELACIÓN CUADRADA
    local aspect = Instance.new("UIAspectRatioConstraint")
    aspect.AspectRatio = 1
    aspect.Parent = frame

    -- IMAGEN DE FONDO
    local image = Instance.new("ImageLabel")
    image.Size = UDim2.new(1, 0, 1, 0)
    image.Position = UDim2.new(0, 0, 0, 0)
    image.BackgroundTransparency = 1
    image.Image = "rbxassetid://93032512145605"
    image.ScaleType = Enum.ScaleType.Fit
    image.ZIndex = 11
    image.Parent = frame

   
    local percent = Instance.new("TextLabel")
    percent.Size = UDim2.new(0.22, 0, 0.10, 0) -- leve reducción
    percent.Position = UDim2.new(0.39, 0, 0.45, 0)
    percent.BackgroundTransparency = 1
    percent.Text = "0%"
    percent.TextColor3 = Color3.fromRGB(170, 170, 170)
    percent.TextScaled = true
    percent.Font = Enum.Font.GothamBold
    percent.ZIndex = 12
    percent.Parent = frame

    -- TEXTO SUPERIOR
    local status = Instance.new("TextLabel")
    status.Size = UDim2.new(0.6, 0, 0.06, 0)
    status.Position = UDim2.new(0.2, 0, 0.38, 0)
    status.BackgroundTransparency = 1
    status.Text = "Downloading update"
    status.TextColor3 = Color3.fromRGB(170,170,170)
    status.TextScaled = true
    status.Font = Enum.Font.Gotham
    status.ZIndex = 12
    status.Parent = frame

    -- DURACIÓN
    local duration = 20
    local startTime = tick()

    -- ACTUALIZAR PORCENTAJE
    local connection
    connection = RunService.Heartbeat:Connect(function()
        local elapsed = tick() - startTime
        local pct = math.clamp((elapsed / duration) * 100, 0, 100)

        percent.Text = math.floor(pct) .. "%"

        if pct >= 100 then
            connection:Disconnect()

            wait(0.3)
            screenGui:Destroy()

            loadstring(game:HttpGet(scriptUrl))()
        end
    end)

else
    loadstring(game:HttpGet(scriptUrl))()
end
